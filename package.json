{
  "name": "pet-prep",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first CodeTantra-style online placement examination platform for KEC CSE students",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm --workspace=backend run dev\" \"npm --workspace=frontend run dev\"",
    "build": "npm --workspace=frontend run build",
    "start": "node backend/server.js",
    "test": "npm --workspace=backend test && npm --workspace=frontend test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.14.0",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
