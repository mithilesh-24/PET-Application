FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    openjdk-17-jdk-headless \
    python3 \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN groupadd -r runner -g 10001 && useradd -r -g runner -u 10001 -m -s /bin/sh runner

COPY docker/pet-supervisor.py /usr/local/bin/pet-supervisor.py
RUN chmod 755 /usr/local/bin/pet-supervisor.py

WORKDIR /work
USER runner

ENTRYPOINT ["python3", "/usr/local/bin/pet-supervisor.py"]
